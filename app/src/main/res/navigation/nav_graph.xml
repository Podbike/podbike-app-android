<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/devicesFragment">

    <fragment
        android:id="@+id/showTutorialFragment"
        android:name="com.podbike.app.ui.ButtonsFragment"
        android:label="fragment_show_tutorial"
        tools:layout="@layout/fragment_buttons">
        <action
            android:id="@+id/action_showTutorialFragment_to_tutorialFragment"
            app:destination="@id/tutorialFragment" />

        <action
            android:id="@+id/action_showTutorialFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />

        <action
            android:id="@+id/action_showTutorialFragment_to_devicesFragment"
            app:destination="@id/devicesFragment" />

        <action
            android:id="@+id/action_showTutorialFragment_to_autoconnectFragment"
            app:destination="@id/autoConnectFragment" />

        <action
            android:id="@+id/action_showTutorialFragment_to_dashboardFragment"
            app:destination="@id/dashboardFragment"
            app:launchSingleTop="true"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/tutorialFragment"
        android:name="com.podbike.app.ui.tutorial.TutorialFragment"
        android:label="SplashFragment"
        tools:layout="@layout/activity_splash">
        <action
            android:id="@+id/action_tutorialFragment_to_showTutorialFragment"
            app:destination="@id/showTutorialFragment" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.podbike.app.ui.settings.SettingsFragment"
        android:label="fragment_settings"
        tools:layout="@layout/fragment_settings">
        <action
            android:id="@+id/action_settingsFragment_to_privacyPolicyFragment"
            app:destination="@id/privacyPolicyFragment" />

        <action
            android:id="@+id/action_settingsFragment_to_devicesFragment"
            app:destination="@id/devicesFragment" />

        <action
            android:id="@+id/action_settingsFragment_to_firmwareUpdateFragment"
            app:destination="@id/firmwareUpdateFragment" />

        <action
            android:id="@+id/action_settingsFragment_to_aboutDeviceFragment"
            app:destination="@id/aboutDeviceFragment" />
    </fragment>

    <fragment
        android:id="@+id/statisticsFragment"
        android:name="com.podbike.app.ui.statistics.StatisticsFragment"
        android:label="fragment_statistics"
        tools:layout="@layout/fragment_statistics" />

    <fragment
        android:id="@+id/privacyPolicyFragment"
        android:name="com.podbike.app.ui.privacy_policy.PrivacyPolicyFragment"
        android:label="fragment_privacy_policy"
        tools:layout="@layout/fragment_privacy_policy" />

    <fragment
        android:id="@+id/devicesFragment"
        android:name="com.podbike.app.ui.devices.DevicesFragment"
        android:label="fragment_devices"
        tools:layout="@layout/fragment_devices">

        <action
            android:id="@+id/action_devicesFragment_to_dashboardFragment"
            app:destination="@id/dashboardFragment"
            app:launchSingleTop="true"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/autoConnectFragment"
        android:name="com.podbike.app.ui.autoconnect.AutoconnectFragment"
        android:label="fragment_auto_connect"
        tools:layout="@layout/fragment_autoconnect">

        <action
            android:id="@+id/action_autoconnectFragment_to_devicesFragment"
            app:destination="@id/devicesFragment"
            app:launchSingleTop="true"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_autoconnectFragment_to_dashboardFragment"
            app:destination="@id/dashboardFragment"
            app:launchSingleTop="true"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.podbike.app.ui.dashboard.DashboardFragment"
        android:label="fragment_dashboard"
        tools:layout="@layout/fragment_dashboard">

        <action
            android:id="@+id/action_dashboardFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />

        <action
            android:id="@+id/action_dashboardFragment_to_statisticsFragment"
            app:destination="@id/statisticsFragment" />

        <action
            android:id="@+id/action_dashboardFragment_to_showTutorialFragment"
            app:destination="@id/showTutorialFragment" />

        <action
            android:id="@+id/action_dashboardFragment_to_devicesFragment"
            app:destination="@id/devicesFragment"
            app:launchSingleTop="true"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/firmwareUpdateFragment"
        android:name="com.podbike.app.ui.firmware_update.FirmwareUpdateFragment"
        android:label="fragment_firmware_update"
        tools:layout="@layout/fragment_firmware_update" />

    <fragment
        android:id="@+id/aboutDeviceFragment"
        android:name="com.podbike.app.ui.about_device.AboutDeviceFragment"
        android:label="fragment_about_device"
        tools:layout="@layout/fragment_about_device" />

</navigation>