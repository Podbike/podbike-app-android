<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:startDestination="@id/showTutorialFragment">

    <fragment
        android:id="@+id/showTutorialFragment"
        android:name="com.podbike.app.ui.tutorial.ShowTutorialFragment"
        android:label="fragment_show_tutorial"
        tools:layout="@layout/fragment_show_tutorial">
        <action
            android:id="@+id/action_showTutorialFragment_to_tutorialFragment"
            app:destination="@id/tutorialFragment" />

        <action
            android:id="@+id/action_showTutorialFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />

    </fragment>

    <fragment
        android:id="@+id/tutorialFragment"
        android:name="com.podbike.app.ui.tutorial.TutorialFragment"
        android:label="SplashFragment"
        tools:layout="@layout/activity_splash">
        <action
            android:id="@+id/action_tutorialFragment_to_showTutorialFragment"
            app:destination="@id/showTutorialFragment" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.podbike.app.ui.settings.SettingsFragment"
        android:label="fragment_settings"
        tools:layout="@layout/fragment_settings">
        <action
            android:id="@+id/action_settingsFragment_to_privacyPolicyFragment"
            app:destination="@id/privacyPolicyFragment" />
    </fragment>

    <fragment
        android:id="@+id/privacyPolicyFragment"
        android:name="com.podbike.app.ui.privacy_policy.PrivacyPolicyFragment"
        android:label="fragment_privacy_policy"
        tools:layout="@layout/fragment_privacy_policy" />

</navigation>