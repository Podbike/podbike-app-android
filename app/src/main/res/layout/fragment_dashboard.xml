<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/fragment_dashboard_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/fragment_dashboard_menu_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/fragment_dashboard_settings"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginTop="36dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_settings_48px"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/fragment_dashboard_logo"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginTop="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_launcher_foreground"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/fragment_dashboard_help"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="36dp"
                android:clickable="true"
                android:focusable="true"
                android:importantForAccessibility="no"
                android:src="@drawable/baseline_help_24"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/fragment_dashboard_icons_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/fragment_dashboard_icon_1"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_material_snowflake_alert" />

            <ImageView
                android:id="@+id/fragment_dashboard_icon_2"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_material_car_traction_control" />

            <ImageView
                android:id="@+id/fragment_dashboard_icon_3"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_material_car_light_alert" />

            <ImageView
                android:id="@+id/fragment_dashboard_icon_4"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_material_car_tire_alert" />

            <ImageView
                android:id="@+id/fragment_dashboard_icon_5"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_material_car_brake_parking" />

        </LinearLayout>


        <TextView
            android:id="@+id/fragment_dashboard_speed"
            style="@style/TextBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="64dp"
            android:includeFontPadding="false"
            android:lineSpacingExtra="0dp"
            android:text="0"
            android:textSize="200dp"
            app:layout_constraintBottom_toTopOf="@id/fragment_dashboard_battery_indicator"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0"
            app:layout_constraintVertical_weight="5" />

        <com.podbike.app.ui.dashboard.view.CustomProgressBar
            android:id="@+id/fragment_dashboard_battery_indicator"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="200dp"
            app:layout_constraintBottom_toTopOf="@id/fragment_dashboard_group"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/fragment_dashboard_speed"
            app:layout_constraintVertical_chainStyle="spread" />

        <TextView
            android:id="@+id/fragment_dashboard_distance"
            style="@style/TextBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:text="252,9"
            android:textSize="50dp"
            android:textStyle="bold"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@id/fragment_dashboard_battery_indicator"
            app:layout_constraintVertical_bias="0.13"
            app:layout_constraintVertical_chainStyle="packed" />


        <TextView
            android:id="@+id/fragment_dashboard_distance_unit"
            style="@style/TextBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="16dp"
            android:text="km"
            android:textSize="20dp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/fragment_dashboard_distance"
            app:layout_constraintLeft_toRightOf="@id/fragment_dashboard_distance"
            app:layout_constraintTop_toTopOf="@id/fragment_dashboard_distance"
            app:layout_constraintVertical_bias="0.39" />

        <ImageView
            android:id="@+id/fragment_dashboard_lights"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginEnd="8dp"
            android:clickable="true"
            android:importantForAccessibility="no"
            android:scaleX="-1"
            android:src="@drawable/ic_material_car_light_dimmed"
            app:layout_constraintBottom_toTopOf="@id/fragment_dashboard_assistance"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/fragment_dashboard_battery_indicator" />

        <androidx.constraintlayout.widget.Group
            android:id="@+id/fragment_dashboard_group"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="fragment_dashboard_assistance, fragment_dashboard_cadence"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/fragment_dashboard_battery_indicator" />

        <com.podbike.app.ui.dashboard.view.AssistanceMeter
            android:id="@+id/fragment_dashboard_assistance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            app:layout_constraintBottom_toTopOf="@id/fragment_dashboard_cadence"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/fragment_dashboard_distance" />

        <com.podbike.app.ui.dashboard.view.CadenceMeter
            android:id="@+id/fragment_dashboard_cadence"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:gravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/fragment_dashboard_assistance" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.podbike.app.ui.dashboard.view.DashboardTurnIndicator
        android:id="@+id/fragment_dashboard_turn_indicator"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.podbike.app.ui.dashboard.view.DashboardHazardIndicator
        android:id="@+id/fragment_dashboard_hazard_indicator"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>